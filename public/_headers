/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/sw.js
  Cache-Control: no-cache

/test-medias/*
  Cache-Control: public, max-age=86400

/polices/*
  Cache-Control: public, max-age=2592000

/motifs/*
  Cache-Control: public, max-age=86400

/vendor/mediabunny-*
  Cache-Control: public, max-age=31536000, immutable

/emoji/*
  Cache-Control: public, max-age=2592000

# Lecteur et back-office : toujours revalidés auprès du serveur (réponse 304 légère si rien n'a changé),
# pour qu'un navigateur ne mélange jamais une vieille version de regles.js avec un admin.js récent.
/lecteur/*
  Cache-Control: no-cache

/admin/*
  Cache-Control: no-cache

/vendor/qrcode.js
  Cache-Control: no-cache
