{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Doit rester identique au nom du Worker dans le tableau de bord Cloudflare (Workers Builds).
  "name": "tv-6mic",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "tv.6mic-aix.fr", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Le Worker passe en premier pour l'API ; le reste (lecteur, diagnostic, médias d'essai) est servi depuis public/.
    "run_worker_first": ["/api/*", "/medias/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tv-6mic",
      "database_id": "593f8d6f-e950-4b63-9480-30957462c372",
      "migrations_dir": "migrations"
    }
  ],
  // Images et vidéos importées depuis le back-office (servies sous /medias/).
  "r2_buckets": [
    { "binding": "MEDIAS", "bucket_name": "tv-6mic-medias" }
  ],
  "observability": { "enabled": true },
  // Avant chaque mise en ligne (wrangler deploy, donc Workers Builds) : tous les essais doivent passer, dont le
  // démarrage du lecteur dans un navigateur simulé (test/lecteur.test.js). Sinon rien n'est déployé.
  "build": { "command": "npm test", "watch_dir": "test" },
  // Surveillance des écrans et alertes par e-mail, toutes les 5 minutes (src/surveillance.mjs).
  "triggers": { "crons": ["*/5 * * * *"] },
  // Garde les variables saisies dans le tableau de bord lors des déploiements depuis GitHub.
  "keep_vars": true
  // Secrets à définir dans le tableau de bord (Settings > Variables and Secrets) : ADMIN_PASSWORD ;
  // pour les alertes, RESEND_API_KEY (clé d'envoi Resend) et ALERTES_A (adresses, séparées par des virgules).
}
